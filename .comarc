!shell<
v() { nvim "$@"; }
dela() { vim dia/main.txt "$@"; }
fela() { vim dia/sci.txt "$@"; }
alias cs="scheme --script"
alias zapret1='doas /home/rsod/bin/zapret1'
alias nslookup='busybox nslookup'
alias ls='ls --color=auto'
alias iwc='iwctl'
alias sway='exec dbus-run-session sway'
alias synccfg='cd ~/swoomp-void && git add -A && git commit -m "new!!" && git push'
alias swayscale='swaymsg -t get_tree | jq ".. | select(.type? and .app_id?) | {app_id: .app_id, rect: .rect}"'
alias please='doas'
alias :q='clear'
alias yi='doas apt install'
alias yr='doas apt purge'
alias yqrs='apt search '
alias swaycfg='nvim ~/.config/sway/config'
alias sudo='doas'
alias alacrittycfg='nvim ~/.config/alacritty/alacritty.toml'
alias gray='swaymsg exec "swaybg -c B1B1B1"'
alias owo='echo "hi hii hello :3 uwu nya meow mmrrrow purr :3"'
alias pomogite='echo "net"'
!end shell
